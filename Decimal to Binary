// Decimal to Binary
import java.util.Scanner;
public class Solution {
    public static void printBinary(int n) {
        if (n <= 1) {
            System.out.print(n);
            return;
        }

        printBinary(n / 2);
        System.out.print(n % 2);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextInt()) {
            int n = sc.nextInt();
            printBinary(n);
        }
        sc.close();
    }
}
