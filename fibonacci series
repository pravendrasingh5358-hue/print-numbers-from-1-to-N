import java.util.Scanner;

public class Solution {
    public static int fibonacci(int n) {
        // Base cases: F(1) = 0, F(2) = 1
        if (n == 1) {
            return 0;
        }
        if (n == 2) {
            return 1;
        }

        return fibonacci(n - 1) + fibonacci(n - 2);
    }

